<Project>
  <!-- Settings shared by every project in the repository. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <Product>BlindsDown</Product>
    <Company>BlindsDown</Company>
    <Authors>Giantflypizza</Authors>
    <Copyright>Copyright (c) 2026 Giantflypizza</Copyright>
    <!-- The version of a build from source. A release build gets it from its tag instead (release.yml passes
         -p:Version), so raise this with every release: the helper's "needs update" check compares versions. -->
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Never ship 32-bit: SetupAPI refuses device changes from WOW64 processes. -->
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    "BlindsDown never connects to the internet" is enforced at compile time:
    any use of a symbol listed in BannedSymbols.txt is a build error (RS0030).
    The analyzer is a build-time tool only; it is not shipped in the app.
  -->
  <ItemGroup Condition="'$(IsTestProject)' != 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>
  <PropertyGroup Condition="'$(IsTestProject)' != 'true'">
    <WarningsAsErrors>$(WarningsAsErrors);RS0030;RS0031;RS0035</WarningsAsErrors>
  </PropertyGroup>
</Project>
